QQ_APPID=your_appid
QQ_APP_SECRET=replace_me

# 可选：提前写死要推送到哪些群；如果留空，机器人在群里被 @ 或被添加进群后会自动记录 group_openid
TARGET_GROUP_OPENIDS=

# 可选：提前写死要推送到哪些私聊用户；如果留空，用户私聊机器人后会自动记录 openid
TARGET_USER_OPENIDS=

# 可选：启动时预置的 B 站视频列表，逗号分隔
BILI_BVIDS=

# 可选：启动时预置要监听评论的 B 站用户 mid/uid，逗号分隔
BILI_WATCH_USER_MIDS=

# 可选：启动时预置要监听评论的 B 站用户昵称，逗号分隔
BILI_WATCH_USER_NAMES=

# 可选：如果 B 站评论接口遇到 412 / 限流，可补登录态
BILI_SESSDATA=

# 轮询间隔（秒）
BILI_POLL_INTERVAL=30

# 每轮最多扫描多少页顶层评论
BILI_MAX_PAGES=10

# 单个 BV 连续失败多少次后发一条私聊告警
BILI_FAILURE_NOTIFY_THRESHOLD=3

# 状态文件路径
STATE_PATH=./state.json
